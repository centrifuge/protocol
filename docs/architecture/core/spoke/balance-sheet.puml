@startuml
title Balance Sheet Flow - Queued Assets State Changes

skinparam sequenceArrowThickness 3
skinparam backgroundColor white
skinparam sequenceMessageAlign center
skinparam maxMessageSize 250
skinparam roundcorner 10
skinparam shadowing false
skinparam defaultFontName "Monospaced"

skinparam sequence {
    ArrowColor #333333
    BoxBorderColor #999999
    BoxBackgroundColor #F9F9F9
    GroupBorderColor #AAAAAA
    GroupBackgroundColor #EEEEEE
}

actor "Pool Manager" as PM
participant Spoke
participant PoolEscrow
participant SnapshotQueue
participant HubHandler
participant Holdings

note over Spoke, HubHandler
    Spoke → Hub communication routes through
    MessageDispatcher → Gateway → adapters → MessageProcessor
end note

== Initial State ==
note over PoolEscrow
    **holding.total:** 2000 USDC
    **availableBalanceOf:** 2000 USDC
end note

note over SnapshotQueue
    **queuedAssets.deposits:** 500 USDC
    **queuedAssets.withdrawals:** 200 USDC
    **queuedShares.nonce:** 0
end note

note over Holdings
    **holding amount:** 5000 USDC
    **snapshot.isSnapshot:** false, **snapshot.nonce:** 0
end note

== Deposit Operation ==
PM -> Spoke: deposit(poolId, scId, USDC, 0, 1000)
activate Spoke
Spoke -> PoolEscrow: deposit(scId, USDC, 0, 1000)
activate PoolEscrow
PoolEscrow --> PoolEscrow: holding.total: 2000 → 3000 USDC
deactivate PoolEscrow
Spoke -> SnapshotQueue: queueAssets(poolId, scId, assetId, 1000, isIncrease: true)
activate SnapshotQueue
SnapshotQueue --> SnapshotQueue: queuedAssets.deposits: 500 → 1500 USDC
deactivate SnapshotQueue
Spoke -> PoolEscrow: safeTransferFrom(caller → escrow, 1000 USDC)
deactivate Spoke

note over PoolEscrow, SnapshotQueue
    **holding.total:** 3000 USDC
    **queuedAssets:** 1500 USDC deposits, 200 USDC withdrawals
end note

== Withdraw Operation ==
PM -> Spoke: withdraw(poolId, scId, USDC, 0, receiver, 800)
activate Spoke
Spoke -> PoolEscrow: withdraw(scId, USDC, 0, receiver, 800)
activate PoolEscrow
PoolEscrow --> PoolEscrow: holding.total: 3000 → 2200 USDC
deactivate PoolEscrow
Spoke -> SnapshotQueue: queueAssets(poolId, scId, assetId, 800, isIncrease: false)
activate SnapshotQueue
SnapshotQueue --> SnapshotQueue: queuedAssets.withdrawals: 200 → 1000 USDC
deactivate SnapshotQueue
Spoke -> PoolEscrow: authTransferTo(USDC, 0, receiver, 800)
deactivate Spoke

note over PoolEscrow, SnapshotQueue
    **holding.total:** 2200 USDC
    **queuedAssets:** 1500 USDC deposits, 1000 USDC withdrawals
end note

== Submit Queued Assets ==
PM -> Spoke: submitQueuedAssets(poolId, scId, assetId, extraGasLimit, refund)
activate Spoke
Spoke -> SnapshotQueue: flushAssets(poolId, scId, assetId)
activate SnapshotQueue
SnapshotQueue --> SnapshotQueue: net = deposits - withdrawals = 500 USDC; clear both to 0, queuedShares.nonce: 0 → 1
SnapshotQueue --> Spoke: UpdateData(netAmount: 500, isIncrease: true, isSnapshot: true, nonce: 0)
deactivate SnapshotQueue
group Send UpdateAssets message to Hub
Spoke -> HubHandler: sendUpdateAssets(poolId, scId, assetId, data, extraGasLimit, refund)
activate HubHandler
HubHandler -> Holdings: increase(poolId, scId, assetId, centrifugeId, 500)
activate Holdings
Holdings --> HubHandler: value = delta priced at the hub valuation
deactivate Holdings
HubHandler --> HubHandler: hub.updateAccountingAmount(poolId, scId, assetId, isPositive: true, value)
HubHandler -> Holdings: setSnapshot(poolId, scId, centrifugeId, isSnapshot: true, nonce: 0)
activate Holdings
Holdings --> Holdings: snapshot.isSnapshot = true, snapshot.nonce: 0 → 1
deactivate Holdings
deactivate HubHandler
end
deactivate Spoke

== Final State ==
note over PoolEscrow
    **holding.total:** 2200 USDC
    **availableBalanceOf:** 2200 USDC
end note

note over SnapshotQueue
    **queuedAssets.deposits:** 0 USDC
    **queuedAssets.withdrawals:** 0 USDC
    **queuedShares.nonce:** 1
end note

note over Holdings
    **holding amount:** 5500 USDC
    **snapshot.isSnapshot:** true, **snapshot.nonce:** 1
end note

@enduml
