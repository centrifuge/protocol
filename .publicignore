# rsync filter rules for the public mirror (centrifuge/protocol).
# '-' excludes, '+' includes. First match wins, so '+' rules must come before their parent '-' rule.
# Paths prefixed with '/' are anchored to the repo root.

# Tests: exclude private subdirectories, keep reusable spell utils tests
+ /test/spell/
+ /test/spell/utils/
+ /test/spell/utils/**

- /test/spell/**
- /test/integration/fork/
- /test/integration/spell/
- /test/integration/env/

# Signer staging for WireToNewNetwork: imports script/ops and EnvConfig, neither of which is mirrored
- /test/script/

# Source: exclude private spell contracts, keep reusable spell utils
+ /src/spell/
+ /src/spell/utils/
+ /src/spell/utils/**

- /src/spell/**

# Scripts: keep only the deployer stack the mirrored tests build on, and its script/ dependencies.
# BaseDeployer <- GatedDeployer <- FullDeployer, which test/integration/{Deployer,EndToEnd,Integration,
# ThreeChainEndToEnd,Create3Addresses} import. The DeployGate ships as bindings only (interface, constants,
# mixin), exactly as createx/ has no CreateX.sol: the contract and its unit test under gate/src and
# gate/test stay private until they move to their own repo. Admin.s.sol carries the Safe constants and the
# Ledger derivation path GatedDeployer signs proposals with. LaunchDeployer is not mirrored: nothing public
# reaches it.
+ /script/
+ /script/deploy/
+ /script/deploy/BaseDeployer.s.sol
+ /script/deploy/GatedDeployer.s.sol
+ /script/deploy/FullDeployer.s.sol
+ /script/utils/
+ /script/utils/Admin.s.sol
+ /script/utils/createx/
+ /script/utils/createx/ICreateX.sol
+ /script/utils/createx/CreateX.d.sol
+ /script/utils/createx/CreateXScript.sol
+ /script/utils/gate/
+ /script/utils/gate/IDeployGate.sol
+ /script/utils/gate/DeployGate.d.sol
+ /script/utils/gate/DeployGateScript.sol
+ /script/utils/JsonRegistry.s.sol

- /script/**

# GitHub Actions: keep only public workflows, exclude everything else
+ /.github/
+ /.github/workflows/
+ /.github/workflows/tests.yml

- /.github/**

# Docs: exclude internal audit out-of-scope lists, keep public audit reports
- /docs/audits/out-of-scope/
